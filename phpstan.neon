includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - src/RouteProvider.php
        - src/RouteInfo.php
        - src/Reflection/RouteReflection.php
    stubFiles:
        - stubs/DeepCopy.stub
    tmpDir: build/phpstan
    typeAliases:
        Rule: 'string|\Illuminate\Contracts\Validation\ValidationRule'
        RuleSet: 'Rule|Rule[]'
    reportUnmatchedIgnoredErrors: false
